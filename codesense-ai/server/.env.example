# ==========================================
# CodeSense AI — Free Production Environment Variables
# ==========================================

# 1. MongoDB Atlas Connection String (Free 512MB M0 Cluster)
# Get your free URI at https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codesense-ai?retryWrites=true&w=majority

# 2. JWT Secret key for authentication signing
JWT_SECRET=generate_a_long_secure_random_string_here

# 3. Server Port (Render sets PORT automatically)
PORT=5000

# 4. Groq API Key (Free High-Speed LLM Inference)
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# 5. Optional: GitHub Personal Access Token (for higher repo fetch limits)
# Get a free classic token at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token_here

# 6. Production Frontend Domain URL for CORS
CLIENT_ORIGIN=https://your-app-name.vercel.app
